---
import Icon from './Icon.astro';
interface Props { id: string; accent: string; monogram: string; large?: boolean }
const { id, accent, monogram, large = false } = Astro.props;
const icon = id === 'al-rimo' ? 'wall' : id === 'a-port' ? 'frame' : 'beam';
---
<div class:list={['mark', { 'mark--lg': large }]} style={`--accent:${accent}`}>
  <Icon name={icon} size={large ? 44 : 30} />
  <span>{monogram}</span>
</div>
<style>
  .mark {
    width: 64px; height: 64px; border-radius: 16px; display: grid; place-items: center; position: relative;
    background: linear-gradient(140deg, var(--navy-800), var(--navy-950)); color: var(--accent);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 10%);
  }
  .mark span {
    position: absolute; right: -6px; bottom: -6px; font-size: .62rem; font-weight: 800; letter-spacing: .05em;
    background: var(--accent); color: var(--navy-950); padding: .1rem .35rem; border-radius: 5px;
  }
  .mark--lg { width: 104px; height: 104px; border-radius: 24px; }
  .mark--lg span { font-size: .8rem; }
</style>
