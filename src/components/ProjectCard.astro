---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'portfolio'> }
const { project } = Astro.props;
const p = project.data;
---
<article class="card project">
  <div class={p.cover ? 'project__cover project__cover--foto' : 'project__cover concreto'}>
    {p.cover && <img class="project__foto" src={p.cover} alt="" loading="lazy" decoding="async" />}
    <img class="project__marca" src="/images/marca/jb-simbolo.svg" alt="" width="49" height="38" loading="lazy" />
    <span class="project__cat">{p.category}</span>
  </div>
  <div class="card__body">
    <h3><a href={`/portfolio/${project.id}/`}>{p.title}</a></h3>
    <p class="project__summary">{p.summary}</p>
    <div class="chips">{p.disciplines.map((d) => <span class="chip">{d}</span>)}</div>
    <a class="project__more" href={`/portfolio/${project.id}/`}>Ver projeto <Icon name="arrow" size={16} /></a>
  </div>
</article>
<style>
  /* capa no estilo dos posts do Instagram: concreto, símbolo branco no canto */
  .project__cover { position: relative; height: 170px; }
  .project__cover--foto { overflow: hidden; background: var(--indigo); }
  .project__cover--foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(19 10 64 / 35%), transparent 40%, rgb(19 10 64 / 30%)); }
  .project__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .project__marca, .project__cat { z-index: 1; }
  .project__marca { position: absolute; top: 1rem; left: 1rem; width: 52px; height: auto; filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgb(0 0 0 / 25%)); }
  .project__cat {
    position: absolute; bottom: 1rem; left: 1rem; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--indigo); background: var(--creme); padding: .3rem .6rem;
  }
  .project h3 { margin: 0; }
  .project h3 a { color: var(--indigo); text-decoration: none; }
  .project h3 a:hover { color: var(--indigo-2); }
  .project__summary { color: var(--text-muted); font-size: .96rem; margin: 0; }
  .project__more { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; text-decoration: none; padding-top: .5rem; color: var(--indigo); }
</style>
