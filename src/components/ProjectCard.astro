---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'portfolio'> }
const { project } = Astro.props;
const p = project.data;
---
<article class="card project">
  <div class="project__cover blueprint">
    <span class="project__cat">{p.category}</span>
    <svg viewBox="0 0 200 90" aria-hidden="true" class="project__drawing">
      <path d="M10 80h180M30 80V35h140v45M30 35l70-25 70 25M65 35v45M100 35v45M135 35v45" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M30 35l35 45M65 35l35 45M100 35l35 45M135 35l35 45" fill="none" stroke="currentColor" stroke-width=".8" opacity=".5" />
    </svg>
  </div>
  <div class="card__body">
    <h3><a href={`/portfolio/${project.id}/`}>{p.title}</a></h3>
    <p class="project__summary">{p.summary}</p>
    <div class="chips">{p.disciplines.map((d) => <span class="chip">{d}</span>)}</div>
    <a class="project__more" href={`/portfolio/${project.id}/`}>Ver projeto <Icon name="arrow" size={16} /></a>
  </div>
</article>
<style>
  .project__cover { position: relative; height: 170px; color: var(--amber); display: grid; place-items: center; }
  .project__drawing { width: 70%; opacity: .9; }
  .project__cat {
    position: absolute; top: 1rem; left: 1rem; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--white); background: rgb(255 255 255 / 10%); border: 1px solid rgb(255 255 255 / 18%); padding: .25rem .6rem; border-radius: 6px;
  }
  .project h3 { margin: 0; }
  .project h3 a { color: var(--navy-900); text-decoration: none; }
  .project h3 a:hover { color: var(--amber-dark); }
  .project__summary { color: var(--text-muted); font-size: .96rem; margin: 0; }
  .project__more { display: inline-flex; align-items: center; gap: .35rem; font-weight: 650; text-decoration: none; padding-top: .5rem; }
</style>
