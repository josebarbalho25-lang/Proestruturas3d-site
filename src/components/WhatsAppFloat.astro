---
import { whatsappLink } from '../config/site';
import Icon from './Icon.astro';
---
<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label="Falar no WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>
<style>
  .wa-float {
    position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 40;
    width: 58px; height: 58px; border-radius: 999px; display: grid; place-items: center;
    background: var(--green-wa); color: var(--white); box-shadow: 0 10px 25px rgb(31 168 85 / 35%);
    transition: transform .15s;
  }
  .wa-float:hover { transform: scale(1.06); color: var(--white); }
</style>
