---
import { SITE } from '../config/site';
interface Props { variant?: 'light' | 'dark' }
const { variant = 'dark' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${variant}`]} aria-label={`${SITE.name}, página inicial`}>
  <svg viewBox="0 0 64 64" width="38" height="38" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0b1f3a" />
    <path d="M14 46 32 14l18 32" fill="none" stroke="#f5a524" stroke-width="5" stroke-linejoin="round" />
    <path d="M21 34h22" stroke="#fff" stroke-width="4" />
    <path d="M10 50h44" stroke="#fff" stroke-width="4" stroke-linecap="round" />
  </svg>
  <span class="logo__text">PRO <strong>Estruturas 3D</strong></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font-size: 1.12rem; letter-spacing: -0.01em; }
  .logo strong { font-weight: 800; }
  .logo--dark { color: var(--navy-900); }
  .logo--light { color: var(--white); }
  .logo--light svg rect { fill: rgb(255 255 255 / 8%); }
  .logo:hover { color: inherit; }
  .logo__text { white-space: nowrap; }
  @media (max-width: 400px) { .logo { font-size: 1rem; gap: .5rem; } }
</style>
