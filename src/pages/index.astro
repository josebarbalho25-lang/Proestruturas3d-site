---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import HireCta from '../components/HireCta.astro';
import Icon from '../components/Icon.astro';
import { SOFTWARES } from '../config/softwares';
import { ENGINEER, whatsappLink } from '../config/site';

const projects = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <section class="hero blueprint">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Engenharia Estrutural · Software House</span>
        <h1>Estruturas calculadas com precisão. Softwares feitos por quem calcula.</h1>
        <p class="lead">
          Projetos estruturais em concreto armado, aço, alvenaria estrutural e fundações, e ferramentas próprias de
          análise estrutural para engenheiros que exigem confiabilidade.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" /> Solicite um Orçamento
          </a>
          <a class="btn btn--ghost-light" href="/softwares/">Conheça os softwares <Icon name="arrow" /></a>
        </div>
        <p class="hero__sign">{ENGINEER.name} · {ENGINEER.crea}</p>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <svg viewBox="0 0 420 360">
          <g fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M60 300V120l150-70 150 70v180" />
            <path d="M60 120h300M60 180h300M60 240h300M60 300h300" />
            <path d="M135 85v215M210 50v250M285 85v215" />
            <path d="M60 120l75 60m0-60 75 60m0-60 75 60m0-60 75 60" opacity=".45" />
          </g>
          <g class="hero__nodes">
            <circle cx="60" cy="300" r="5" /><circle cx="135" cy="300" r="5" /><circle cx="210" cy="300" r="5" />
            <circle cx="285" cy="300" r="5" /><circle cx="360" cy="300" r="5" /><circle cx="210" cy="50" r="5" />
          </g>
          <path d="M40 318h340" stroke="currentColor" stroke-width="3" />
          <path d="M50 318l-12 14M80 318l-12 14M110 318l-12 14M140 318l-12 14M170 318l-12 14M200 318l-12 14M230 318l-12 14M260 318l-12 14M290 318l-12 14M320 318l-12 14M350 318l-12 14M380 318l-12 14" stroke="currentColor" stroke-width="1.2" opacity=".6" />
          <path class="hero__load" d="M210 0v38m-7-10 7 10 7-10" fill="none" stroke-width="2.5" />
        </svg>
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>Áreas de atuação</dt><dd>Concreto · Aço · Fundações</dd></div>
        <div><dt>Softwares próprios</dt><dd>3 ferramentas</dd></div>
        <div><dt>Normas</dt><dd>NBR 6118 · 8800 · 14762 · 6122</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Softwares</span>
        <h2>Ferramentas de cálculo estrutural</h2>
        <p class="lead">Desenvolvidas a partir da experiência real de projeto, para acelerar o seu trabalho sem abrir mão do rigor técnico.</p>
      </div>
      <div class="grid grid--3">
        {SOFTWARES.map((s) => <SoftwareCard software={s} />)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Portfólio</span>
        <h2>Projetos entregues</h2>
        <p class="lead">Do residencial ao comercial de grande porte: fundações, contenções, concreto armado e estruturas metálicas.</p>
      </div>
      <div class="grid grid--3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="more"><a class="btn btn--outline" href="/portfolio/">Ver portfólio e serviços <Icon name="arrow" /></a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Blog</span>
          <h2>Artigos e novidades</h2>
        </div>
        <div class="grid grid--3">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
        <p class="more"><a class="btn btn--outline" href="/blog/">Ver todos os artigos <Icon name="arrow" /></a></p>
      </div>
    </section>
  )}

  <HireCta />
</BaseLayout>

<style>
  .hero { color: var(--steel-300); padding: clamp(4rem, 9vw, 7rem) 0 3rem; overflow: hidden; }
  .hero__inner { display: grid; grid-template-columns: 1.15fr .85fr; gap: 3rem; align-items: center; }
  .hero h1 { color: var(--white); }
  .hero .lead { color: var(--steel-300); margin-bottom: 2rem; }
  .hero__sign { margin: 1.75rem 0 0; font-size: .88rem; color: var(--steel-500); letter-spacing: .02em; }
  .hero__visual { color: rgb(255 255 255 / 55%); }
  .hero__nodes { fill: var(--amber); }
  .hero__load { stroke: var(--amber); }
  .stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 3.5rem 0 0;
    background: rgb(255 255 255 / 10%); border: 1px solid rgb(255 255 255 / 10%); border-radius: var(--radius); overflow: hidden;
  }
  .stats div { background: var(--navy-900); padding: 1.25rem 1.5rem; }
  .stats dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; color: var(--steel-500); }
  .stats dd { margin: .25rem 0 0; color: var(--white); font-weight: 650; }
  .more { margin: 2.5rem 0 0; text-align: center; }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { max-width: 340px; }
    .stats { grid-template-columns: 1fr; }
  }
</style>
