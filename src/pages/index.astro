---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import HireCta from '../components/HireCta.astro';
import Icon from '../components/Icon.astro';
import { SOFTWARES } from '../config/softwares';
import { ENGINEER, whatsappLink } from '../config/site';

const projects = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="sr-only">{ENGINEER.name}, engenheiro estrutural: projetos estruturais e softwares de cálculo</h1>
        <img class="hero__logo" src="/images/marca/jb-completa.svg" alt="Jose Barbalho, Engenheiro Civil" width="196" height="88" />
        <p class="lead">
          Projetos estruturais <mark>econômicos e seguros</mark> em concreto armado, alvenaria estrutural, aço e
          fundações, e softwares de cálculo feitos por quem calcula todo dia.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" /> Solicite um Orçamento
          </a>
          <a class="btn btn--outline" href="/softwares/">Conheça os softwares <Icon name="arrow" /></a>
        </div>
      </div>

      <figure class="hero__obra">
        <img src="/images/projetos/area-gourmet-render.jpg" alt="Render de projeto com área gourmet coberta" width="596" height="335" />
      </figure>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>Áreas de atuação</dt><dd>Concreto · Alvenaria · Aço · Fundações</dd></div>
        <div><dt>Softwares próprios</dt><dd>3 ferramentas</dd></div>
        <div><dt>Normas</dt><dd>NBR 6118 · 16868 · 8800 · 6122</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Softwares</span>
        <h2>Ferramentas de cálculo estrutural</h2>
        <p class="lead">Desenvolvidas a partir da experiência real de projeto, para acelerar o seu trabalho sem abrir mão do rigor técnico.</p>
      </div>
      <div class="grid grid--3">
        {SOFTWARES.map((s) => <SoftwareCard software={s} />)}
      </div>
    </div>
  </section>

  <section class="section concreto--claro">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Portfólio</span>
        <h2>Projetos entregues</h2>
        <p class="lead">Do residencial ao comercial de grande porte: fundações, contenções, concreto armado e estruturas metálicas.</p>
      </div>
      <div class="grid grid--3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="more"><a class="btn btn--outline" href="/portfolio/">Ver portfólio e serviços <Icon name="arrow" /></a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Blog</span>
          <h2>Artigos e novidades</h2>
        </div>
        <div class="grid grid--3">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
        <p class="more"><a class="btn btn--outline" href="/blog/">Ver todos os artigos <Icon name="arrow" /></a></p>
      </div>
    </section>
  )}

  <HireCta />
</BaseLayout>

<style>
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 3rem; border-bottom: 1px solid var(--border); }
  .hero__inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero__copy { display: grid; gap: 1.6rem; justify-items: start; }
  .hero__logo { width: min(440px, 100%); height: auto; }
  .hero .lead { margin: 0; color: var(--steel-600); }
  .hero__obra { margin: 0; box-shadow: var(--shadow-lg); }
  .hero__obra img { width: 100%; height: auto; aspect-ratio: 596 / 335; object-fit: cover; }
  .stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 3.5rem 0 0;
    border-top: 1px solid var(--border);
  }
  .stats div { padding: 1.25rem 1.5rem 0 0; }
  .stats div + div { padding-left: 1.5rem; border-left: 1px solid var(--border); }
  .stats dt { font-family: var(--font-selo); font-size: .68rem; text-transform: uppercase; letter-spacing: .3em; color: var(--grafite); }
  .stats dd { margin: .35rem 0 0; color: var(--indigo); font-family: var(--font-titulo); text-transform: uppercase; font-size: 1.15rem; letter-spacing: .02em; }
  .more { margin: 2.5rem 0 0; text-align: center; }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    .stats div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--border); }
    .stats div { padding: 1rem 0; }
  }
</style>
