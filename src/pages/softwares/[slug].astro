---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoftwareMark from '../../components/SoftwareMark.astro';
import ProductButtons from '../../components/ProductButtons.astro';
import PricingPlans from '../../components/PricingPlans.astro';
import HireCta from '../../components/HireCta.astro';
import Icon from '../../components/Icon.astro';
import { SOFTWARES, type Software } from '../../config/softwares';
import { LOJA } from '../../config/api';

export function getStaticPaths() {
  return SOFTWARES.map((software) => ({ params: { slug: software.id }, props: { software } }));
}
interface Props { software: Software }
const { software: s } = Astro.props;
const others = SOFTWARES.filter((o) => o.id !== s.id);
---
<BaseLayout title={s.name} description={`${s.name}: ${s.tagline}.`}>
  <section class="page-hero blueprint">
    <div class="container sw-hero">
      <SoftwareMark id={s.id} accent={s.accent} monogram={s.monogram} logo={s.logo} name={s.name} large />
      <div>
        <span class="eyebrow">{s.status}</span>
        <h1>{s.name}</h1>
        <p class="lead">{s.tagline}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container sw-detail">
      <div>
        <h2>Sobre o {s.name}</h2>
        <p class="lead">{s.description}</p>
        <h3>Principais recursos</h3>
        <ul class="features">
          {s.features.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}
        </ul>
      </div>
      <aside class="card buy-box" id="planos">
        <div class="card__body">
          {s.plans?.some((p) => p.online) && (
            <div class="obrigado" data-obrigado hidden role="status">
              <strong>Assinatura recebida, obrigado!</strong>
              <p>Assim que o Mercado Pago confirmar o pagamento, o {s.name} ativa com o e-mail que você informou.
                <a href={LOJA.baixar(s.id)} rel="nofollow"><strong>Baixe o instalador aqui</strong></a> e, na tela de ativação, digite esse mesmo e-mail.</p>
            </div>
          )}
          <h3>Obtenha o {s.name}</h3>
          <dl class="specs">
            {s.specs.map((sp) => <div><dt>{sp.label}</dt><dd>{sp.value}</dd></div>)}
          </dl>
          {s.plans ? <PricingPlans software={s} /> : null}
          {s.plans ? (
            s.download.mode !== 'soon' && (
              <button type="button" class="btn btn--outline" data-product-id={s.id} data-product-action="download">
                <Icon name={s.download.mode === 'whatsapp' ? 'whatsapp' : 'download'} /> {s.download.label}
              </button>
            )
          ) : (
            <ProductButtons software={s} />
          )}
          {s.deliveryNote && <p class="buy-box__note"><Icon name="lock" size={16} /> {s.deliveryNote}</p>}
        </div>
      </aside>
    </div>
  </section>

  {s.screens && s.screens.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Telas</span><h2>Por dentro do {s.name}</h2></div>
        <div class="telas">
          {s.screens.map((t) => (
            <figure>
              <a href={t.src} target="_blank" rel="noopener"><img src={t.src} alt={t.alt} loading="lazy" /></a>
              <figcaption>{t.alt}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Outros softwares</h2>
      <ul class="others">
        {others.map((o) => <li><a href={`/softwares/${o.id}/`}><strong>{o.name}</strong> <span>{o.tagline}</span></a></li>)}
      </ul>
    </div>
  </section>
  <HireCta />
</BaseLayout>

<style>
  .obrigado { border: 2px solid var(--amber); background: #fdf4d3; border-radius: var(--radius-sm); padding: .85rem 1rem; margin-bottom: 1rem; }
  .obrigado p { margin: .35rem 0 0; font-size: .92rem; }
  .sw-hero { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .sw-hero h1 { margin-bottom: .3rem; }
  .sw-detail { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
  .features { list-style: none; padding: 0; display: grid; gap: .8rem; }
  .features li { display: flex; gap: .6rem; align-items: flex-start; }
  .features :global(svg) { color: var(--amber-dark); margin-top: .3rem; flex: none; }
  .buy-box { position: sticky; top: 96px; scroll-margin-top: 96px; }
  .buy-box__note { display: flex; gap: .45rem; align-items: flex-start; font-size: .85rem; color: var(--steel-500); margin: .5rem 0 0; }
  .buy-box__note :global(svg) { flex: none; margin-top: .2rem; }
  .specs { margin: 0; display: grid; gap: .5rem; padding-bottom: .75rem; border-bottom: 1px solid var(--border); }
  .specs div { display: flex; justify-content: space-between; gap: 1rem; font-size: .92rem; }
  .specs dt { color: var(--steel-500); }
  .specs dd { margin: 0; font-weight: 650; color: var(--navy-900); text-align: right; }
  .telas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .telas figure { margin: 0; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .telas img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: contain; background: #fff; border-bottom: 1px solid var(--border); }
  .telas figcaption { padding: .8rem 1rem; font-size: .9rem; color: var(--text-muted); }
  @media (max-width: 760px) { .telas { grid-template-columns: 1fr; } }
  .others { list-style: none; padding: 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .others a { display: block; padding: 1.1rem 1.25rem; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; }
  .others strong { color: var(--navy-900); display: block; }
  .others span { color: var(--text-muted); font-size: .93rem; }
  @media (max-width: 860px) { .sw-detail { grid-template-columns: 1fr; } .buy-box { position: static; } }
</style>
<script>
  // O Mercado Pago devolve o cliente para cá com ?preapproval_id=… depois de assinar.
  const volta = new URLSearchParams(location.search);
  if (volta.has('preapproval_id') || volta.get('assinatura') === 'ok') {
    const caixa = document.querySelector<HTMLElement>('[data-obrigado]');
    if (caixa) { caixa.hidden = false; caixa.scrollIntoView({ block: 'center' }); }
  }
</script>
