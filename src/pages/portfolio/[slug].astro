---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HireCta from '../../components/HireCta.astro';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'portfolio'> }
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---
<BaseLayout title={p.title} description={p.summary}>
  <section class={p.cover ? 'page-hero page-hero--foto' : 'page-hero blueprint'} style={p.cover ? `--capa: url('${p.gallery[0]?.src ?? p.cover}')` : undefined}>
    <div class="container">
      <a class="back" href="/portfolio/">← Portfólio</a>
      <span class="eyebrow">{p.category}</span>
      <h1>{p.title}</h1>
      <p class="lead">{p.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="container project-detail">
      <article class="prose"><Content /></article>
      <aside class="card"><div class="card__body">
        <h3>Ficha técnica</h3>
        <dl class="facts">
          {p.highlights.map((h) => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}
          {p.location && <div><dt>Local</dt><dd>{p.location}</dd></div>}
          {p.year && <div><dt>Ano</dt><dd>{p.year}</dd></div>}
        </dl>
        <h4>Disciplinas</h4>
        <div class="chips">{p.disciplines.map((d) => <span class="chip">{d}</span>)}</div>
      </div></aside>
    </div>
  </section>
  {p.video && (
    <section class="section video-sec">
      <div class="container">
        <span class="eyebrow">{p.video.eyebrow}</span>
        <h2>{p.video.title}</h2>
        <figure class:list={['video', { 'video--vertical': p.video.vertical }]}>
          {p.video.mode === 'loop' ? (
            <video poster={p.video.poster} autoplay muted loop playsinline preload="metadata" aria-label={p.video.caption}>
              <source src={p.video.src} type="video/mp4" />
              <source src={p.video.src.replace(/\.mp4$/, '.webm')} type="video/webm" />
            </video>
          ) : (
            <video poster={p.video.poster} controls muted playsinline preload="none" aria-label={p.video.caption}>
              <source src={p.video.src} type="video/mp4" />
              <source src={p.video.src.replace(/\.mp4$/, '.webm')} type="video/webm" />
            </video>
          )}
          <figcaption>{p.video.caption}</figcaption>
        </figure>
      </div>
    </section>
  )}
  {[
    ...(p.gallery.length ? [{
      eyebrow: p.galleryKind === 'pranchas' ? 'Do projeto' : 'Na obra',
      title: p.galleryKind === 'pranchas' ? 'Modelos e pranchas' : 'Fotos da execução',
      intro: undefined, kind: p.galleryKind, items: p.gallery,
    }] : []),
    ...p.galleries,
  ].map((g, i) => (
    <section class:list={['section', 'galeria-sec', i % 2 === 0 ? 'concreto--claro' : 'galeria-sec--papel']}>
      <div class="container">
        <span class="eyebrow">{g.eyebrow}</span>
        <h2>{g.title}</h2>
        {g.intro && <p class="galeria-intro">{g.intro}</p>}
        <div class:list={['galeria', { 'galeria--pranchas': g.kind === 'pranchas' }]}>
          {g.items.map((f) => (
            <figure>
              <a href={f.src} target="_blank" rel="noopener"><img src={f.src} alt={f.alt} loading="lazy" decoding="async" /></a>
              <figcaption>{f.alt}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}
  <HireCta />
</BaseLayout>
<style>
  .back { color: var(--steel-600); text-decoration: none; display: block; width: fit-content; margin-bottom: 1.25rem; font-size: .92rem; }
  .back:hover { color: var(--indigo); }
  .project-detail { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: start; }
  .facts { margin: 0 0 1rem; display: grid; gap: .8rem; }
  .facts dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--steel-500); }
  .facts dd { margin: 0; font-weight: 650; color: var(--navy-900); }
  h4 { margin: .5rem 0 .25rem; font-size: .95rem; }
  .page-hero--foto { position: relative; background: var(--indigo) var(--capa) center / cover no-repeat; }
  .page-hero--foto::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(19 10 64 / 88%), rgb(19 10 64 / 55%)); }
  .page-hero--foto .container { position: relative; }
  .page-hero--foto h1, .page-hero--foto .lead, .page-hero--foto .back, .page-hero--foto .eyebrow { color: #fff; }
  .page-hero--foto .eyebrow { color: var(--creme); }
  .video { margin: 1.5rem 0 0; }
  .video video { display: block; width: 100%; max-width: 960px; aspect-ratio: 848 / 478; background: var(--indigo); }
  .video--vertical video { max-width: 360px; aspect-ratio: 9 / 16; }
  .video--vertical figcaption { max-width: 360px; }
  .video figcaption { font-size: .88rem; color: var(--grafite); margin-top: .6rem; }
  .galeria-intro { max-width: 70ch; color: var(--grafite); margin: .5rem 0 0; }
  .galeria { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  .galeria figure { margin: 0; background: #fff; box-shadow: 0 1px 3px rgb(19 10 64 / 12%); }
  .galeria img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .galeria--pranchas { grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); }
  .galeria--pranchas img { object-fit: contain; background: #fff; padding: .5rem; }
  .galeria figcaption { padding: .65rem .8rem; font-size: .88rem; color: var(--grafite); }
  @media (max-width: 860px) { .project-detail { grid-template-columns: 1fr; } }
</style>
