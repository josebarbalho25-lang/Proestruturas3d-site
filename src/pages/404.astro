---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada">
  <section class="page-hero blueprint" style="min-height:60vh;display:grid;align-items:center">
    <div class="container">
      <span class="eyebrow">Erro 404</span>
      <h1>Esta página não foi encontrada</h1>
      <p class="lead">O endereço pode ter mudado. Volte para o início e continue navegando.</p>
      <p style="margin-top:1.5rem"><a class="btn btn--primary" href="/">Voltar para o início</a></p>
    </div>
  </section>
</BaseLayout>
