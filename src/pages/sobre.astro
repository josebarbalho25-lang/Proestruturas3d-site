---
import BaseLayout from '../layouts/BaseLayout.astro';
import HireCta from '../components/HireCta.astro';
import { ENGINEER } from '../config/site';

const timeline = [
  { period: '2023', title: 'Engenharia Civil', text: 'Formado em Engenharia Civil, com foco em cálculo estrutural desde o início.' },
  { period: 'Residencial', title: 'Casas e contenções', text: 'Projetos estruturais de residências, fundações, cortinas de estacas e coberturas metálicas. Mais de 2.000 m² projetados.' },
  { period: 'Fim de 2025 até hoje', title: 'Expansão de shopping center', text: 'Lojas e deck parking: concreto armado, fundações, steel deck, estruturas mistas, metálicas secundárias e reforços. Um novo projeto em aprovação.' },
  { period: 'Hoje', title: 'Softwares de cálculo', text: 'Pró-Viga 3D já à venda; Al-rimo (muros de arrimo em alvenaria estrutural) e A-PORT (pórticos e cascas) em desenvolvimento.' },
];
const skills = ['Concreto Armado', 'Alvenaria Estrutural', 'Estruturas Metálicas', 'Perfis Formados a Frio', 'Fundações', 'Muros de Arrimo', 'Piso Industrial', 'Hidrossanitário', 'Análise Não-Linear', 'Elementos Finitos'];
---
<BaseLayout title="Sobre o Engenheiro" description={`Conheça a trajetória de ${ENGINEER.name}, ${ENGINEER.role}.`}>
  <section class="page-hero blueprint">
    <div class="container">
      <span class="eyebrow">Sobre o Engenheiro</span>
      <h1>{ENGINEER.name}</h1>
      <p class="lead">{ENGINEER.role} · {ENGINEER.crea}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <figure class="about__photo">
        <img src="/images/marca/jose-barbalho.jpg" alt="Eng. José Barbalho segurando uma prancha de projeto estrutural" width="1000" height="1241" />
      </figure>
      <div class="prose">
        <h2>Engenharia com rigor técnico e visão de produto</h2>
        <p>
          Sou engenheiro civil e calculista estrutural, formado em 2023. Já são mais de 2.000 m² projetados, entre
          residências, fundações, contenções em cortina de estacas e coberturas metálicas, sempre buscando a estrutura
          mais segura com o mínimo de concreto e aço.
        </p>
        <p>
          Desde o fim de 2025 calculo a expansão de um shopping center: as lojas e o deck parking, em concreto armado,
          alvenaria estrutural, fundações, steel deck, estruturas mistas e metálicas secundárias, além dos reforços da
          estrutura existente. São mais de 40 pranchas entregues e um novo projeto em aprovação.
        </p>
        <p>
          A rotina de projeto me levou a criar as minhas próprias ferramentas de cálculo. Assim nasceu a{' '}
          <strong>PRO Estruturas 3D</strong>. O <strong>Pró-Viga 3D</strong> já está à venda, e o{' '}
          <strong>Al-rimo</strong>, para muros de arrimo em alvenaria estrutural, e o <strong>A-PORT</strong>, para análise
          de pórticos e cascas, estão em desenvolvimento. São softwares feitos por quem calcula todo dia, com memória de
          cálculo que cita a norma.
        </p>
        <div class="chips">{skills.map((s) => <span class="chip">{s}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Trajetória</span><h2>Experiência</h2></div>
      <ol class="timeline">
        {timeline.map((t) => (
          <li><span class="timeline__period">{t.period}</span><h3>{t.title}</h3><p>{t.text}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <HireCta />
</BaseLayout>

<style>
  .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3.5rem; align-items: start; }
  .about__photo { margin: 0; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); }
  .about__photo img { display: block; width: 100%; height: auto; aspect-ratio: 1000 / 1241; object-fit: cover; }
  .about .prose h2 { margin-top: 0; }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem; }
  .timeline li { background: var(--white); border: 1px solid var(--border); border-top: 4px solid var(--amber); border-radius: var(--radius); padding: 1.5rem; }
  .timeline__period { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--amber-dark); }
  .timeline h3 { margin: .4rem 0; }
  .timeline p { margin: 0; color: var(--text-muted); font-size: .96rem; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .about__photo { max-width: 360px; } }
</style>
